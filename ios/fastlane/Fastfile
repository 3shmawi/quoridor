# Used by the TestFlight job in .github/workflows/release.yml. Every input
# comes from the environment that job sets from GitHub Secrets.
default_platform(:ios)

APP_ID = "com.MoReH.quoridor"

platform :ios do
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    import_certificate(
      certificate_path: ENV["IOS_CERTIFICATE_PATH"],
      certificate_password: ENV["IOS_CERTIFICATE_PASSWORD"],
      keychain_name: ENV["MATCH_KEYCHAIN_NAME"],
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"]
    )

    # Downloads, or creates, the App Store profile for the app.
    get_provisioning_profile(api_key: api_key, app_identifier: APP_ID)

    update_code_signing_settings(
      path: "Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV["APPLE_TEAM_ID"],
      targets: ["Runner"],
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME]
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { APP_ID => lane_context[SharedValues::SIGH_NAME] }
      }
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
